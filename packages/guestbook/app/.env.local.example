# Copy to .env.local and fill in. .env.local is git-ignored.
# Both chains (Fuji + local anvil) are live at once; switch networks in the wallet. Set the
# address for whichever chain(s) you've deployed to.

# Guestbook address on Fuji, printed by `just deploy-fuji-live` in ../contracts.
NEXT_PUBLIC_GUESTBOOK_ADDRESS_FUJI=0xcFb3Ae5944CAE5291d9167bBdDFF1beC5c45b290

# Guestbook address on local anvil, printed by `just deploy-local` in ../contracts.
NEXT_PUBLIC_GUESTBOOK_ADDRESS_LOCAL=

# Optional: custom Fuji RPC (better rate limits under finale load). Falls back to the
# public endpoint if unset.
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
