# Copy to .env and fill in. .env is git-ignored — never commit real values.
# No private key here: the deployer key lives in an encrypted foundry keystore
# (`just wallet-import`), not in this file.

# Avalanche Fuji testnet C-Chain RPC.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Public address of the keystore wallet (the `--sender` for deploys). Address, not key.
DEPLOYER_ADDRESS=
